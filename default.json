{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate baseline for all kepler repositories. Repos consume this via \"extends\": [\"github>fits-ki/renovate-config\"] and keep only project-specific settings locally.",
  "extends": [
    "config:recommended",
    ":separateMultipleMajorReleases",
    "group:react"
  ],
  "baseBranchPatterns": [
    "develop"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 0-7 * * 1"
  ],
  "updateNotScheduled": false,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "dependencyDashboardApproval": true,
  "automerge": false,
  "platformAutomerge": false,
  "configMigration": false,
  "ignoreTests": false,
  "osvVulnerabilityAlerts": true,
  "ignoreUnstable": true,
  "ignoreScripts": true,
  "ignorePlugins": true,
  "semanticCommits": "enabled",
  "pinDigests": true,
  "postUpdateOptions": [
    "pnpmDedupe"
  ],
  "labels": [
    "dependencies"
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 3,
  "branchConcurrentLimit": 3,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-7 * * 1"
    ],
    "dependencyDashboardApproval": true,
    "automerge": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "updateNotScheduled": true,
    "minimumReleaseAge": null,
    "groupName": null,
    "dependencyDashboardApproval": true,
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0,
    "branchConcurrentLimit": 0,
    "automerge": false,
    "labels": [
      "dependencies",
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "Major upgrades require manual approval in the Dependency Dashboard",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Low-noise: batch compatible CI and infrastructure updates",
      "matchManagers": [
        "github-actions",
        "dockerfile",
        "docker-compose",
        "devcontainer"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest"
      ],
      "matchJsonata": [
        "$not(enabled = false) and $not(dependencyDashboardApproval = true) and $not(isVulnerabilityAlert = true)"
      ],
      "groupName": "CI and infrastructure"
    },
    {
      "description": "setup-php: github-tags digest lookup is unreliable with pinDigests; keep version updates without digest resolution warnings",
      "matchPackageNames": [
        "shivammathur/setup-php"
      ],
      "pinDigests": false
    },
    {
      "description": "Manual-only: every update type waits for an explicit Dependency Dashboard approval (no automatic branches or PRs); keep as the last preset rule",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "rollback",
        "bump",
        "replacement"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
